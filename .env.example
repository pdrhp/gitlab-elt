# Secret Injection via Files (Docker/Kubernetes secrets)
# -------------------------------------------------------
# For each environment variable KEY, you can optionally use KEY_FILE instead.
# The value of KEY_FILE should be a path to a file containing the secret.
#
# Priority: Direct env var (KEY) takes precedence over KEY_FILE.
# If KEY is set (even to empty string), KEY_FILE is ignored.
# If KEY is unset or empty, the content of the file at KEY_FILE is used.
#
# Example:
#   POSTGRES_PASSWORD=mysupersecret     # Direct value
#   # OR
#   POSTGRES_PASSWORD_FILE=/run/secrets/db-password  # Read from file

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=gitlab_elt
POSTGRES_USER_FILE=
POSTGRES_PASSWORD=gitlab_elt_dev
POSTGRES_PASSWORD_FILE=
POSTGRES_DB=gitlab_elt

# GitLab
GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN=your-gitlab-token-here
GITLAB_TOKEN_FILE=

# GitLab Projects (comma-separated list of project IDs to sync)
# At least one of GITLAB_PROJECT_IDS or GITLAB_GROUP_IDS must be set
# If this list is empty, you must configure GITLAB_GROUP_IDS
GITLAB_PROJECT_IDS=

# GitLab Groups (comma-separated list of group IDs to discover projects from)
# Discovery service will find all projects in these groups automatically
# At least one of GITLAB_PROJECT_IDS or GITLAB_GROUP_IDS must be set
GITLAB_GROUP_IDS=

# Health Check
HEALTH_PORT=8080

# Rate Limiting (optional)
GITLAB_RATE_LIMIT=20
GITLAB_RETRY_MAX=3

# Scheduler Configuration (optional - cron expressions)
SCHEDULER_SYNC_PEAK=*/15 * * * *
SCHEDULER_SYNC_OFFPEAK=0 */4 * * *
SCHEDULER_DISCOVERY=0 */6 * * *

# OTLP Metrics Push (optional)
# OTEL_METRICS_ENDPOINT - full OTLP/HTTP endpoint (e.g., https://alloy.internal:4318). Leave empty to disable push.
# OTEL_METRICS_HEADERS - optional comma-separated key=value pairs sent with each OTLP request (e.g., Authorization=Bearer xxx, X-Scope-OrgID=dev).
# OTEL_METRICS_INSECURE - set to true to allow plain HTTP endpoints or to skip TLS verification for self-signed certificates (default false).
OTEL_METRICS_ENDPOINT=
OTEL_METRICS_HEADERS=
OTEL_METRICS_INSECURE=false

# OTLP Traces Push (optional)
# OTEL_TRACES_ENDPOINT - OTLP/HTTP endpoint for exporting spans (e.g., https://tempo.internal:4318). Leave empty to disable tracing export.
# OTEL_TRACES_HEADERS - optional comma-separated key=value pairs attached to trace export requests.
# OTEL_TRACES_INSECURE - set true to allow HTTP endpoints or skip TLS verification (default false).
# OTEL_TRACES_SAMPLER - controls sampling strategy: always_on, always_off, parentbased_always_on, or traceidratio:<0-1> (default parentbased_always_on).
OTEL_TRACES_ENDPOINT=
OTEL_TRACES_HEADERS=
OTEL_TRACES_INSECURE=false
OTEL_TRACES_SAMPLER=parentbased_always_on

# OTEL Resource Metadata (optional)
# These attributes are attached to all OTLP metrics/traces/logs.
# OTEL_SERVICE_NAME - logical service name (default: gitlab-elt-worker)
# OTEL_SERVICE_VERSION - semantic version string (default empty)
# OTEL_ENVIRONMENT - deployment environment (default: production)
# OTEL_SERVICE_NAMESPACE - optional namespace to group services (e.g., gitlab-elt)
# OTEL_SERVICE_INSTANCE_ID - unique instance identifier; defaults to hostname if empty
# OTEL_RESOURCE_ATTRIBUTES - extra comma-separated key=value pairs (e.g., region=us-east-1,team=data)
OTEL_SERVICE_NAME=
OTEL_SERVICE_VERSION=
OTEL_ENVIRONMENT=
OTEL_SERVICE_NAMESPACE=
OTEL_SERVICE_INSTANCE_ID=
OTEL_RESOURCE_ATTRIBUTES=
